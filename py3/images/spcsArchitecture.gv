digraph {
	rankdir=TB
	labeljust=l nodesep=0.4 ranksep=0.9
	newrank=true
	splines=spline
	fontsize=11
	subgraph cluster_infra {
		fillcolor=lightsteelblue fontname=bold fontsize=14 label="(1) PyCS Infrastructure --- frozen framework (bisos.csSeed + bisos.fileObj) --- consumed as-is" style=filled
		{
			rank=same
			inf_spcs_mech [label=".spcs / .pcs mechanism
(bisos.csSeed)
plantWithWhich() +
atexit registrar +
seededCsxuInfo" fillcolor=white shape=rectangle style=filled]
			inf_branch_spcs [label="ftoBranchProc.spcs
+ ftoBranch-seed.cs
(branch-side .spcs)" fillcolor=salmon margin="0.25,0.15" shape=rarrow style=filled]
			inf_walker [label="fto walker + Cmnds
(treeRecurse,
fto_forwardToLeaves,
fto_walkRunExternal)" fillcolor=white shape=rectangle style=filled]
			inf_spec [label="WalkExampleSpec
(dataclass:
cmndName, pars, args,
comment, mode, tags)" fillcolor=lightblue shape=rectangle style=filled]
			inf_spcs_mech -> inf_branch_spcs [style=invis weight=100]
			inf_branch_spcs -> inf_walker [style=invis weight=100]
			inf_walker -> inf_spec [style=invis weight=100]
		}
		inf_branch_spcs -> inf_spcs_mech [label="is a" arrowhead=vee constraint=false fontsize=10 style=dashed]
		inf_branch_spcs -> inf_walker [label=drives arrowhead=vee constraint=false fontsize=10 style=dashed]
		inf_spec -> inf_branch_spcs [label="rendered by" arrowhead=vee constraint=false fontsize=10 style=dashed]
	}
	subgraph cluster_seed {
		fillcolor=mistyrose fontname=bold fontsize=14 label="(2) Custom Seed --- authored per new domain (containerProc today; lcntProc, staticWebProc, ... tomorrow)" style=filled
		{
			rank=same
			seed_csu [label="<domain>_csu.py
(the actual Cmnds:
containerProc_imageBuild,
containerProc_instanceUp,
...)" fillcolor=white shape=rectangle style=filled]
			seed_info [label="<domain>_seedInfo.py
paramsFromPlantPath()
+ walkExamples()" fillcolor=white shape=rectangle style=filled]
			seed_walkex [label="walkExamples()
→ list of
WalkExampleSpec
(SOURCE OF TRUTH
for \"what to walk with\")" fillcolor=lightblue shape=rectangle style=filled]
			seed_cs [label="<domain>-seed.cs
(seed CSXU:
csuList + g_csMain)" fillcolor=white shape=rectangle style=filled]
			seed_leaf_spcs [label="leaf .spcs
(dockerProc.spcs,
lcntProc.spcs, ...)" fillcolor=salmon margin="0.25,0.15" shape=rarrow style=filled]
			seed_csu -> seed_info [style=invis weight=100]
			seed_info -> seed_walkex [style=invis weight=100]
			seed_walkex -> seed_cs [style=invis weight=100]
			seed_cs -> seed_leaf_spcs [style=invis weight=100]
		}
		seed_csu -> seed_cs [label="in csuList" arrowhead=vee constraint=false fontsize=10 style=dashed]
		seed_info -> seed_cs [label="consulted by" arrowhead=vee constraint=false fontsize=10 style=dashed]
		seed_walkex -> seed_info [label="defined in" arrowhead=vee constraint=false dir=back fontsize=10 style=dashed]
		seed_leaf_spcs -> seed_cs [label=plants arrowhead=vee constraint=false fontsize=10 style=dashed]
	}
	subgraph cluster_tree {
		fillcolor=darkseagreen3 fontname=bold fontsize=14 label="(3) Planted Tree --- built by planting, not writing Python (bro_dockerfiles today; bro_lcnt, ... tomorrow)" style=filled
		{
			rank=same
			tree_bpo [label="BPO tree root
bro_dockerfiles/
(bro_lcnt/, ... future)" fillcolor=lightyellow shape=folder style=filled]
			tree_branch_dir [label="branch/ dir
_tree_=branch
_treeProc_=
ftoBranchProc.spcs
+ planted .spcs" fillcolor=lightyellow shape=folder style=filled]
			tree_aux_dir [label="auxBranch/ dir
(pass-through)
_tree_=auxBranch" fillcolor=lightyellow shape=folder style=filled]
			tree_leaf_dir [label="leaf/ dir
_tree_=leaf
_treeProc_=<domain>.spcs
+ planted leaf .spcs
+ leaf payload
(Dockerfile, LaTeX, ...)" fillcolor=lightyellow shape=folder style=filled]
			tree_bpo -> tree_branch_dir [style=invis weight=100]
			tree_branch_dir -> tree_aux_dir [style=invis weight=100]
			tree_aux_dir -> tree_leaf_dir [style=invis weight=100]
		}
		tree_bpo -> tree_branch_dir [label=contains arrowhead=none constraint=false fontsize=10]
		tree_branch_dir -> tree_aux_dir [arrowhead=none constraint=false fontsize=10]
		tree_aux_dir -> tree_leaf_dir [arrowhead=none constraint=false fontsize=10]
	}
	tree_branch_dir -> seed_cs [style=invis weight=10]
	seed_cs -> inf_walker [style=invis weight=10]
	seed_leaf_spcs -> inf_spcs_mech [label="is a" color=dodgerblue constraint=false dir=back fontcolor=dodgerblue penwidth=2 style=solid]
	seed_walkex -> inf_spec [label=populates color=dodgerblue constraint=false dir=back fontcolor=dodgerblue penwidth=2 style=solid]
	inf_branch_spcs -> tree_branch_dir [label="planted at branches" color=dodgerblue constraint=false fontcolor=dodgerblue penwidth=2 style=dotted]
	seed_leaf_spcs -> tree_leaf_dir [label="planted at leaves" color=dodgerblue constraint=false fontcolor=dodgerblue penwidth=2 style=dotted]
	inf_walker -> tree_leaf_dir [label="walks to" color=purple constraint=false fontcolor=purple penwidth=2 style=solid]
	engineer [label=engineer fillcolor=thistle fontsize=14 shape=ellipse style=filled width=1.5]
	{
		rank=same
		seed_leaf_spcs
		engineer
	}
	engineer -> seed_cs [label="authors (Box 2)" arrowhead=vee constraint=false fontcolor=black style=dashed]
	engineer -> tree_branch_dir [label="plants + invokes (Box 3)" arrowhead=vee constraint=false fontcolor=black style=dashed]
}
